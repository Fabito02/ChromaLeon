msgstr "Tèma d’icònas de dossièr"

#: ui/preferencesPage.js:341
msgid "Applies the accent color to folder icons."
msgstr "Aplica la color de refortiment a las icònas de dossièr."

#: ui/preferencesPage.js:347
msgid "Application icon theme"
msgstr "Tèma d'icònas d'aplicacions"

#: ui/preferencesPage.js:348
msgid "Applies the accent color to some app icons."
msgstr "Aplica la color de refortiment a una icònas de dossièr."

#: ui/preferencesPage.js:352
