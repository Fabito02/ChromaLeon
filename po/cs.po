#: chromaleon.js:111
msgid "Wallpaper"
msgstr "Pozadí"

#: chromaleon.js:115
msgid "Preferences"
msgstr "Nastavení"

#: chromaleon.js:159
msgid "Accent Color"
msgstr "Barevný nádech"

#: chromaleon.js:160
msgid "New colors only apply when apps are reopened."
msgstr "Nové barvy se aplikují až po restartu aplikací."

#: chromaleon.js:164
msgid "Main color"
msgstr "Hlavní barva"

#: chromaleon.js:187
msgid "Wallpaper Colors"
msgstr "Barvy pozadí"

#: chromaleon.js:189
msgid ""
"The system automatically updates the accent color based on your wallpaper."
msgstr "Systém automaticky aktualizuje barvu nádechu na základě barvy pozadí."

#: chromaleon.js:224
msgid "Additional colors"
msgstr "Další barvy"

#: chromaleon.js:261
msgid "Add wallpapers"
msgstr "Přidat pozadí"

#: chromaleon.js:275
msgid "Wallpapers"
msgstr "Pozadí"

#: chromaleon.js:298
msgid "Tint GNOME"
msgstr "Zabarvit GNOME"

#: chromaleon.js:299
msgid "Based on Tint my GNOME"
msgstr "Založeno na Tint my GNOME"

#: chromaleon.js:304
msgid "Tint Shell"
msgstr "Zabarvit systém"

#: chromaleon.js:305
msgid "Tints the GNOME Shell with the color of your choice."
msgstr "Zabarví GNOME Shell zvolenou barvou."

#: chromaleon.js:313
msgid "Tint Apps"
msgstr "Zabarvit aplikace"

#: chromaleon.js:315
msgid "Tints the LibAdwaita applications with the color of your choice."
msgstr "Zabarví LibAdwaita aplikace zvolenou barvou."

#: chromaleon.js:324
msgid ""
"Also tint the GTK3 apps (the {0} extension and the {1} theme are required to "
"avoid bugs)."
msgstr ""
"Zabarví také GTK3 aplikace (pro správné fungování je vyžadováno rozšíření "
"{0} a motiv {1})."

#: chromaleon.js:337
msgid "Tint GTK3 Apps"
msgstr "Zabarvit GTK3 aplikace"

#: chromaleon.js:374
msgid "Icon Theme"
msgstr "Motiv ikon"

#: chromaleon.js:379
msgid "Folder icon theme"
msgstr "Motiv ikon složky"

#: chromaleon.js:380
msgid "Applies the accent color to folder icons."
msgstr "Aplikuje barvu nádechu na ikony složek."

#: chromaleon.js:388
msgid "Application icon theme"
msgstr "Motiv ikon aplikací"

#: chromaleon.js:389
msgid "Applies the accent color to some app icons."
msgstr "Aplikuje barvu nádechu na ikony některých aplikací."

#: chromaleon.js:397
msgid "MoreWaita"
msgstr "MoreWaita"

#: chromaleon.js:398
msgid "Applies integration with the MoreWaita icon pack."
msgstr "Aplikuje integraci s balíčkem ikon MoreWaita."

#: chromaleon.js:441
msgid "Miscellaneous"
msgstr "Různé"

#: chromaleon.js:446
msgid "Apply to Flatpaks"
msgstr "Aplikovat na balíčky Flatpak"

#: chromaleon.js:448
msgid "Allow Flatpaks to access your custom accent color variables."
msgstr "Dovolit balíčkům Flatpak přistupovat k Vašim barevným proměnným."

#: chromaleon.js:456
msgid "Enable shortcut"
msgstr "Vytvořit zástupce"

#: chromaleon.js:458
msgid "Create a shortcut in the app grid by adding a .desktop file."
msgstr "Vytvoří zástupce v mřížce aplikací přidáním souboru .desktop."

#: chromaleon.js:628
msgid "Wallpaper deleted successfully!"
msgstr "Pozadí úspěšně odstraněno!"

#: chromaleon.js:635
msgid "Failed to delete wallpaper"
msgstr "Odstranění pozadí selhalo"

#: chromaleon.js:642
msgid "Select a Wallpaper"
msgstr "Vyberte pozadí"

#: chromaleon.js:644
msgid "_Open"
msgstr "_Otevřít"

#: chromaleon.js:645
msgid "_Cancel"
msgstr "_Zrušit"

#: chromaleon.js:650
msgid "All Images"
msgstr "Všechny obrázky"

#: chromaleon.js:677
msgid "Wallpaper already exists!"
msgstr "Pozadí již existuje!"

#: chromaleon.js:693
msgid "Wallpaper added successfully!"
msgstr "Pozadí úspěšně přidáno!"

#: chromaleon.js:1143
msgid "Unable to load colors."
msgstr "Nelze načíst barvy."

#: chromaleon.js:1285 chromaleon.js:1310
msgid "Support"
msgstr "Podpora"

#: chromaleon.js:1297
msgid "Support the project"
msgstr "Podpořit projekt"

#: chromaleon.js:1303
msgid "Why support ChromaLeon?"
msgstr "Proč podpořit ChromaLeon?"

#: chromaleon.js:1305
msgid ""
"Developing free software requires time, energy, and dedication. Your "
"donation directly supports the project and helps keep it alive!"
msgstr ""
"Vývoj bezplatného software vyžaduje čas, energii a oddanost. Váš dar přímo "
"podpoří tento projekt a pomůže udržovat ho při životě!"

#: chromaleon.js:1309
msgid "Cancel"
msgstr "Zrušit"

