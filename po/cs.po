msgid "Cancel"
msgstr "Zrušit"

#: chromaleon.js:479
msgid "Continue"
msgstr ""

#: chromaleon.js:500
msgid "Enable shortcut"
msgstr "Vytvořit zástupce"

#: chromaleon.js:502
msgid "Create a shortcut in the app grid by adding a .desktop file."
msgstr "Vytvoří zástupce v mřížce aplikací přidáním souboru .desktop."

#: chromaleon.js:675
msgid "Wallpaper deleted successfully!"
msgstr "Pozadí úspěšně odstraněno!"

#: chromaleon.js:682
msgid "Failed to delete wallpaper"
msgstr "Odstranění pozadí selhalo"

#: chromaleon.js:689
msgid "Select a Wallpaper"
msgstr "Vyberte pozadí"

#: chromaleon.js:691
msgid "_Open"
msgstr "_Otevřít"

#: chromaleon.js:692
msgid "_Cancel"
msgstr "_Zrušit"

#: chromaleon.js:697
msgid "All Images"
msgstr "Všechny obrázky"

#: chromaleon.js:724
msgid "Wallpaper already exists!"
msgstr "Pozadí již existuje!"

#: chromaleon.js:740
msgid "Wallpaper added successfully!"
msgstr "Pozadí úspěšně přidáno!"

#: chromaleon.js:1190
msgid "Unable to load colors."
msgstr "Nelze načíst barvy."

#: chromaleon.js:1332 chromaleon.js:1357
msgid "Support"
msgstr "Podpora"

#: chromaleon.js:1344
msgid "Support the project"
msgstr "Podpořit projekt"

#: chromaleon.js:1350
msgid "Why support ChromaLeon?"
msgstr "Proč podpořit ChromaLeon?"

#: chromaleon.js:1352
msgid ""
"Developing free software requires time, energy, and dedication. Your "
"donation directly supports the project and helps keep it alive!"
msgstr ""
"Vývoj bezplatného software vyžaduje čas, energii a oddanost. Váš dar přímo "
"podpoří tento projekt a pomůže udržovat ho při životě!"
