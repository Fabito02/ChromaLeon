msgstr "Nové barvy se aplikují až po restartu aplikací."

#: chromaleon.js:193
msgid "Main color"
msgstr "Hlavní barva"

#: chromaleon.js:216
msgid "Wallpaper Colors"
msgstr "Barvy pozadí"

#: chromaleon.js:218
msgid ""
"The system automatically updates the accent color based on your wallpaper."
msgstr "Systém automaticky aktualizuje barvu nádechu na základě barvy pozadí."

#: chromaleon.js:253
msgid "Additional colors"
msgstr "Další barvy"

#: chromaleon.js:290
