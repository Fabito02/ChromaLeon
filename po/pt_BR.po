msgstr "Cores do GNOME"

#: chromaleon.js:401
msgid "Use native GNOME colors instead of wallpaper colors."
msgstr "Usa as cores nativas do GNOME ao invés das cores do wallpaper."

#: chromaleon.js:406
msgid "Prefer Light Style"
msgstr "Preferir o Estilo Claro"

#: chromaleon.js:407
msgid "Use a light style for the Shell in the light theme."
msgstr "Usa um estilo claro para o Shell quando no tema claro."

#: chromaleon.js:426
msgid "Tint GNOME"
msgstr "Tingir o GNOME"

