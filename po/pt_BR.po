#: chromaleon.js:130
msgid "Error getting thumbnail: "
msgstr "Erro ao buscar thumbnail: "

#: chromaleon.js:139
msgid "Wallpaper"
msgstr "Plano de fundo"

#: chromaleon.js:144
msgid "Preferences"
msgstr "Preferências"

#: chromaleon.js:195 chromaleon.js:233
msgid "Accent Color"
msgstr "Cor de destaque"

#: chromaleon.js:205
msgid "Main color"
msgstr "Cor principal"

#: chromaleon.js:233
msgid "Wallpaper Colors"
msgstr "Cores do plano de fundo"

#: chromaleon.js:239
msgid ""
"The system automatically updates the accent color based on your wallpaper."
msgstr ""
"O sistema atualiza automaticamente a cor de destaque com base no wallpaper."

#: chromaleon.js:297
msgid "Additional colors"
msgstr "Cores adicionais"

#: chromaleon.js:334
msgid "Add wallpapers"
msgstr "Adicionar planos de fundo"

#: chromaleon.js:348
msgid "Wallpapers"
msgstr "Planos de fundo"

#: chromaleon.js:398
msgid "Colors"
msgstr "Cores"

#: chromaleon.js:403
msgid "GNOME Colors"
msgstr "Cores do GNOME"

#: chromaleon.js:404
msgid "Use native GNOME colors instead of wallpaper colors."
msgstr "Usa as cores nativas do GNOME ao invés das cores do wallpaper."

#: chromaleon.js:409
msgid "Prefer Light Style"
msgstr "Preferir o Estilo Claro"

#: chromaleon.js:410
msgid "Use a light style for the Shell in the light theme."
msgstr "Usa um estilo claro para o Shell quando no tema claro."

#: chromaleon.js:429
msgid "Tint GNOME"
msgstr "Tingir o GNOME"

#: chromaleon.js:430
msgid "Based on Tint my GNOME"
msgstr "Baseado em Tint my GNOME"

#: chromaleon.js:435
msgid "Tint Shell"
msgstr "Tingir o Shell"

#: chromaleon.js:436
msgid "Tints the GNOME Shell with the color of your choice."
msgstr "Tingir o GNOME Shell com a cor de sua escolha."

#: chromaleon.js:442
msgid "Tint Panel"
msgstr "Tingir o Painel"

#: chromaleon.js:444
msgid ""
"Keeping this disabled resolves issues with panel modifications in extensions "
"such as \"Blur My Shell\" and \"PaperWM\"."
msgstr ""
"Manter isso desativado resolve problemas com modificações no painel feitas "
"por extensões como \"Blur My Shell\" e \"PaperWM\"."

#: chromaleon.js:458
msgid "Tint Apps"
msgstr "Tingir Aplicativos"

#: chromaleon.js:460
msgid "Tints the LibAdwaita applications with the color of your choice."
msgstr "Tingir os aplicativos LibAdwaita com a cor de sua escolha."

#: chromaleon.js:467
msgid ""
"Also tint the GTK3 apps (the {0} extension and the {1} theme are required to "
"avoid bugs)."
msgstr ""
"Também, tinja aplicativos GTK3 (a extensão {0} e o tema {1} são necessários "
"para evitar erros)."

#: chromaleon.js:480
msgid "Tint GTK3 Apps"
msgstr "Tingir Aplicativos GTK3"

#: chromaleon.js:494
msgid "Darker Tint"
msgstr "Tingimento escurecido"

#: chromaleon.js:495
msgid "Applies a darker tint."
msgstr "Aplica um tingimento mais escuro."

#: chromaleon.js:535
msgid "Icon Theme"
msgstr "Tema de ícones"

#: chromaleon.js:540
msgid "Folder icon theme"
msgstr "Tema de ícones em pastas"

#: chromaleon.js:541
msgid "Applies the accent color to folder icons."
msgstr "Aplica a cor de destaque a ícones de pastas."

#: chromaleon.js:547
msgid "Application icon theme"
msgstr "Tema de ícones em aplicativos"

#: chromaleon.js:548
msgid "Applies the accent color to some app icons."
msgstr "Aplica a cor de destaque a alguns ícones de aplicativos."

#: chromaleon.js:552
msgid "MoreWaita"
msgstr "MoreWaita"

#: chromaleon.js:553
msgid "Applies integration with the MoreWaita icon pack."
msgstr "Aplica a integração com o pacote de ícones MoreWaita."

#: chromaleon.js:588
msgid "Customization"
msgstr "Customização"

#: chromaleon.js:593
msgid "Custom stylesheet"
msgstr "Stylesheet customizado"

#: chromaleon.js:595
msgid ""
"A file that overrides the CSS of the shell and user extensions, with support "
"for ChromaLeon accent colors."
msgstr ""
"Um arquivo que substitui o CSS do shell e das extensões do usuário, com "
"suporte para as cores de destaque do ChromaLeon."

#: chromaleon.js:614 chromaleon.js:631
msgid "About the custom stylesheet"
msgstr "Sobre o stylesheet customizado"

#: chromaleon.js:620
msgid "Open file"
msgstr "Abrir arquivo"

#: chromaleon.js:633
msgid ""
"This file is used to apply custom CSS to GNOME Shell.\n"
"\n"
"The extension processes all content within this file, replacing the "
"<b><tt>@@ACCENT@@</tt></b> and <b><tt>-st-accent-color</tt></b> variables "
"with the color selected in the ChromaLeon settings before applying them to "
"the system. This can be useful if an extension does not have the accent "
"colors applied correctly.\n"
"\n"
"<b>Tip:</b> If your changes do not take effect, try adding <b><tt>!"
"important</tt></b> to your CSS rules."
msgstr ""
"Este arquivo é usado para aplicar CSS personalizado ao GNOME Shell.\n"
"\n"
"A extensão processa todo o conteúdo dentro deste arquivo, substituindo as "
"variáveis <b><tt>@@ACCENT@@</tt></b> e <b><tt>-st-accent-color</tt></b> pela "
"cor selecionada nas configurações do ChromaLeon antes de aplicá-las ao "
"sistema. Isso pode ser útil se uma extensão não tiver as cores de destaque "
"aplicadas corretamente.\n"
"\n"
"<b>Dica:</b> Se as suas alterações não surtirem efeito, tente adicionar "
"<b><tt>!important</tt></b> às suas regras CSS."

#: chromaleon.js:640
msgid "Close"
msgstr "Fechar"

#: chromaleon.js:662
msgid "Failed to open custom.css: "
msgstr "Falhou em abrir custom.css: "

#: chromaleon.js:669
msgid "Miscellaneous"
msgstr "Diversos"

#: chromaleon.js:674
msgid "Apply to Flatpaks"
msgstr "Aplicar em Flatpaks"

#: chromaleon.js:676
msgid "Allow Flatpaks to access your custom accent color variables."
msgstr ""
"Permitir que os Flatpaks acessem suas variáveis de cor de destaque "
"personalizadas."

#: chromaleon.js:682
msgid "Enable shortcut"
msgstr "Habilitar atalho"

#: chromaleon.js:684
msgid "Create a shortcut in the app grid by adding a .desktop file."
msgstr ""
"Cria um atalho na grade de aplicativos adicionando um arquivo .desktop."

#: chromaleon.js:808
msgid "Wallpaper deleted successfully!"
msgstr "Plano de fundo deletado com sucesso!"

#: chromaleon.js:812
msgid "Error deleting wallpaper: "
msgstr "Falha ao deletar plano de fundo: "

#: chromaleon.js:818
msgid "Select a Wallpaper"
msgstr "Selecionar um plano de fundo"

#: chromaleon.js:820
msgid "_Open"
msgstr "Abrir"

#: chromaleon.js:821
msgid "_Cancel"
msgstr "Cancelar"

#: chromaleon.js:826
msgid "All Images"
msgstr "Todas as imagens"

#: chromaleon.js:853
msgid "Wallpaper already exists!"
msgstr "Plano de fundo já existe!"

#: chromaleon.js:869
msgid "Wallpaper added successfully!"
msgstr "Plano de fundo adicionado com sucesso!"

#: chromaleon.js:873
msgid "Error copying wallpaper: "
msgstr "Erro ao copiar plano de fundo: "

#: chromaleon.js:1309
msgid "Unable to load colors."
msgstr "Não foi possível carregar as cores."

#: chromaleon.js:1590 chromaleon.js:1614
msgid "Support"
msgstr "Apoiar"

#: chromaleon.js:1602
msgid "Support the project"
msgstr "Apoie o projeto"

#: chromaleon.js:1607
msgid "Why support ChromaLeon?"
msgstr "Por que apoiar o ChromaLeon?"

#: chromaleon.js:1609
msgid ""
"Developing free software requires time, energy, and dedication. Your "
"donation directly supports the project and helps keep it alive!"
msgstr ""
"Desenvolver software livre requer tempo, energia e dedicação. Sua doação "
"apoia diretamente o projeto e ajuda a mantê-lo vivo!"

#: chromaleon.js:1613
msgid "Cancel"
msgstr "Cancelar"

