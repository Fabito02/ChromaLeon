msgid "_Open"
msgstr "Abrir"

#: chromaleon.js:760
msgid "_Cancel"
msgstr "Cancelar"

#: chromaleon.js:765
msgid "All Images"
msgstr "Todas as imagens"

#: chromaleon.js:792
msgid "Wallpaper already exists!"
msgstr "Plano de fundo já existe!"

#: chromaleon.js:808
