msgstr "Aplicativos alvo"

#: ui/preloadPage.js:71
msgid ""
"Enter the process name (e.g., firefox, thunderbird, zen-browser) to apply "
"the ChromaLeon accent color."
msgstr ""
"Insira o nome do processo (ex: firefox, thunderbird, zen-browser) para "
"aplicar a cor de destaque do ChromaLeon."

#: ui/preloadPage.js:77
msgid "Add Application"
msgstr "Adicionar Aplicativo"

#: ui/preloadPage.js:117
