msgstr "Basado en Tint my GNOME"

#: chromaleon.js:331
msgid "Tint Shell"
msgstr "Teñir Shell"

#: chromaleon.js:332
msgid "Tints the GNOME Shell with the color of your choice."
msgstr "Tiñe el GNOME Shell con el color de tu elección."

#: chromaleon.js:340
msgid "Tint Apps"
msgstr "Teñir Apps"

#: chromaleon.js:342
msgid "Tints the LibAdwaita applications with the color of your choice."
msgstr "Tiñe las aplicaciones LibAdwaita con el color de su elección."

#: chromaleon.js:351
msgid ""
"Also tint the GTK3 apps (the {0} extension and the {1} theme are required to "
"avoid bugs)."
msgstr ""
"También tiñe las aplicaciones GTK3 (la extensión {0} y el tema {1} son "
"necesarios para evitar errores)."

#: chromaleon.js:364
msgid "Tint GTK3 Apps"
msgstr "Teñir Apps GTK3"

#: chromaleon.js:401
msgid "Icon Theme"
msgstr "Tema de iconos"

#: chromaleon.js:406
msgid "Folder icon theme"
msgstr "Tema de iconos de carpeta"

#: chromaleon.js:407
msgid "Applies the accent color to folder icons."
msgstr "Aplica el color de acento a los iconos de las carpetas."

#: chromaleon.js:415
msgid "Application icon theme"
msgstr "Tema de iconos de aplicaciones"

#: chromaleon.js:416
msgid "Applies the accent color to some app icons."
msgstr "Aplica el color de acento a algunos iconos de aplicaciones."

#: chromaleon.js:424
msgid "MoreWaita"
msgstr "MoreWaita"

#: chromaleon.js:425
msgid "Applies integration with the MoreWaita icon pack."
msgstr "Aplica la integración con el paquete de iconos MoreWaita."

#: chromaleon.js:468
msgid "Customization"
msgstr ""

#: chromaleon.js:473
msgid "Custom stylesheet"
msgstr ""

#: chromaleon.js:475
msgid ""
"A file that overrides the CSS of the shell and user extensions, with support "
"for ChromaLeon accent colors."
msgstr ""

#: chromaleon.js:482 chromaleon.js:498
msgid "About the custom stylesheet"
msgstr ""

#: chromaleon.js:488
msgid "Open file"
msgstr ""

#: chromaleon.js:500
msgid ""
"This file is used to apply custom CSS to GNOME Shell.\n"
"\n"
"The extension processes all content within this file, replacing the "
"<b><tt>@@ACCENT@@</tt></b> and <b><tt>-st-accent-color</tt></b> variables "
"with the color selected in the ChromaLeon settings before applying them to "
"the system. This can be useful if an extension does not have the accent "
"colors applied correctly.\n"
"\n"
"<b>Tip:</b> If your changes do not take effect, try adding <b><tt>!"
"important</tt></b> to your CSS rules."
msgstr ""

