#: chromaleon.js:111
msgid "Wallpaper"
msgstr "Fondo de pantalla"

#: chromaleon.js:115
msgid "Preferences"
msgstr "Preferencias"

#: chromaleon.js:148
msgid "Accent Color"
msgstr "Color de acento"

#: chromaleon.js:149
msgid "New colors only apply when apps are reopened."
msgstr ""
"Los nuevos colores solo se aplican cuando se vuelven a abrir las "
"aplicaciones."

#: chromaleon.js:153
msgid "Main color"
msgstr "Color principal"

#: chromaleon.js:176
msgid "Wallpaper Colors"
msgstr "Colores del fondo de pantalla"

#: chromaleon.js:178
msgid ""
"The system automatically updates the accent color based on your wallpaper."
msgstr ""
"El sistema actualiza automáticamente el color de acento según tu fondo de "
"pantalla."

#: chromaleon.js:213
msgid "Additional colors"
msgstr "Colores adicionales"

#: chromaleon.js:250
msgid "Add wallpapers"
msgstr "Añadir fondos de pantalla"

#: chromaleon.js:264
msgid "Wallpapers"
msgstr "Fondos de pantalla"

#: chromaleon.js:287
msgid "Tint GNOME"
msgstr "Teñir GNOME"

#: chromaleon.js:288
msgid "Based on Tint my GNOME"
msgstr "Basado en Tint my GNOME"

#: chromaleon.js:293
msgid "Tint Shell"
msgstr "Teñir Shell"

#: chromaleon.js:294
msgid "Tints the GNOME Shell with the color of your choice."
msgstr "Tiñe el GNOME Shell con el color de tu elección."

#: chromaleon.js:302
msgid "Tint Apps"
msgstr "Teñir Apps"

#: chromaleon.js:304
msgid "Tints the LibAdwaita applications with the color of your choice."
msgstr "Tiñe las aplicaciones LibAdwaita con el color de su elección."

#: chromaleon.js:313
msgid ""
"Also tint the GTK3 apps (the {0} extension and the {1} theme are required to "
"avoid bugs)."
msgstr ""
"También tiñe las aplicaciones GTK3 (la extensión {0} y el tema {1} son "
"necesarios para evitar errores)."

#: chromaleon.js:326
msgid "Tint GTK3 Apps"
msgstr "Teñir Apps GTK3"

#: chromaleon.js:363
msgid "Icon Theme"
msgstr "Tema de iconos"

#: chromaleon.js:368
msgid "Folder icon theme"
msgstr "Tema de iconos de carpeta"

#: chromaleon.js:369
msgid "Applies the accent color to folder icons."
msgstr "Aplica el color de acento a los iconos de las carpetas."

#: chromaleon.js:377
msgid "Application icon theme"
msgstr "Tema de iconos de aplicaciones"

#: chromaleon.js:378
msgid "Applies the accent color to some app icons."
msgstr "Aplica el color de acento a algunos iconos de aplicaciones."

#: chromaleon.js:386
msgid "MoreWaita"
msgstr "MoreWaita"

#: chromaleon.js:387
msgid "Applies integration with the MoreWaita icon pack."
msgstr "Aplica la integración con el paquete de iconos MoreWaita."

#: chromaleon.js:430
msgid "Miscellaneous"
msgstr "Diversos"

#: chromaleon.js:435
msgid "Apply to Flatpaks"
msgstr "Aplicar a Flatpacks"

#: chromaleon.js:437
msgid "Allow Flatpaks to access your custom accent color variables."
msgstr ""
"Permitir que los Flatpaks accedan a tus variables de color de acento "
"personalizadas."

#: chromaleon.js:445
msgid "Enable Firefox support"
msgstr ""

#: chromaleon.js:447
msgid ""
"Matches Firefox and some derivatives colors with your system accent color "
"instead of GNOME defaults"
msgstr ""

#: chromaleon.js:472
msgid "Disable Firefox accent theme?"
msgstr ""

#: chromaleon.js:474
msgid ""
"Firefox needs to close to apply this change. Please ensure any unsaved work "
"is saved."
msgstr ""

#: chromaleon.js:478 chromaleon.js:1356
msgid "Cancel"
msgstr "Cancelar"

#: chromaleon.js:479
msgid "Continue"
msgstr ""

#: chromaleon.js:500
msgid "Enable shortcut"
msgstr "Habilitar atajo"

#: chromaleon.js:502
msgid "Create a shortcut in the app grid by adding a .desktop file."
msgstr ""
"Crea un atajo en la cuadrícula de aplicaciones añadiendo un archivo .desktop."

#: chromaleon.js:675
msgid "Wallpaper deleted successfully!"
msgstr "¡Fondo de pantalla eliminado correctamente!"

#: chromaleon.js:682
msgid "Failed to delete wallpaper"
msgstr "No se pudo eliminar el fondo de pantalla"

#: chromaleon.js:689
msgid "Select a Wallpaper"
msgstr "Seleccione un fondo de pantalla"

#: chromaleon.js:691
msgid "_Open"
msgstr "_Abrir"

#: chromaleon.js:692
msgid "_Cancel"
msgstr "_Cancelar"

#: chromaleon.js:697
msgid "All Images"
msgstr "Todas las imágenes"

#: chromaleon.js:724
msgid "Wallpaper already exists!"
msgstr "¡El fondo de pantalla ya existe!"

#: chromaleon.js:740
msgid "Wallpaper added successfully!"
msgstr "¡Fondo de pantalla añadido correctamente!"

#: chromaleon.js:1190
msgid "Unable to load colors."
msgstr "Error al cargar los colores."

#: chromaleon.js:1332 chromaleon.js:1357
msgid "Support"
msgstr "Apoyar"

#: chromaleon.js:1344
msgid "Support the project"
msgstr "Apoyar el proyecto"

#: chromaleon.js:1350
msgid "Why support ChromaLeon?"
msgstr "¿Por qué apoyar a ChromaLeon?"

#: chromaleon.js:1352
msgid ""
"Developing free software requires time, energy, and dedication. Your "
"donation directly supports the project and helps keep it alive!"
msgstr ""
"Desarrollar software libre requiere tiempo, energía y dedicación. ¡Tu "
"donación apoya directamente al proyecto y ayuda a mantenerlo vivo!"
