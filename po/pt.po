#: chromaleon.js:111
msgid "Wallpaper"
msgstr "Plano de fundo"

#: chromaleon.js:115
msgid "Preferences"
msgstr "Preferências"

#: chromaleon.js:159
msgid "Accent Color"
msgstr "Cor de destaque"

#: chromaleon.js:160
msgid "New colors only apply when apps are reopened."
msgstr "Novas cores só aplicam quando apps são reiniciadas."

#: chromaleon.js:164
msgid "Main color"
msgstr "Cor principal"

#: chromaleon.js:187
msgid "Wallpaper Colors"
msgstr "Cores do plano de fundo"

#: chromaleon.js:189
msgid ""
"The system automatically updates the accent color based on your wallpaper."
msgstr ""
"O sistema atualiza automaticamente a cor de destaque com base no wallpaper."

#: chromaleon.js:224
msgid "Additional colors"
msgstr "Cores adicionais"

#: chromaleon.js:261
msgid "Add wallpapers"
msgstr "Adicionar planos de fundo"

#: chromaleon.js:275
msgid "Wallpapers"
msgstr "Planos de fundo"

#: chromaleon.js:298
msgid "Tint GNOME"
msgstr "Tingir o GNOME"

#: chromaleon.js:299
msgid "Based on Tint my GNOME"
msgstr "Baseado em Tint my GNOME"

#: chromaleon.js:304
msgid "Tint Shell"
msgstr "Tingir o Shell"

#: chromaleon.js:305
msgid "Tints the GNOME Shell with the color of your choice."
msgstr "Tingir o GNOME Shell com a cor da sua escolha."

#: chromaleon.js:313
msgid "Tint Apps"
msgstr "Tingir Apps"

#: chromaleon.js:315
msgid "Tints the LibAdwaita applications with the color of your choice."
msgstr "Tingir apps LibAdwaita com a cor da sua escolha."

#: chromaleon.js:324
msgid ""
"Also tint the GTK3 apps (the {0} extension and the {1} theme are required to "
"avoid bugs)."
msgstr ""
"Também, tinja apps GTK3 (a extensão {0} e o tema {1} são necessários para "
"evitar erros)."

#: chromaleon.js:337
msgid "Tint GTK3 Apps"
msgstr "Tingir Apps GTK3"

#: chromaleon.js:374
msgid "Icon Theme"
msgstr "Tema de ícones"

#: chromaleon.js:379
msgid "Folder icon theme"
msgstr "Tema de ícones em pastas"

#: chromaleon.js:380
msgid "Applies the accent color to folder icons."
msgstr "Aplica a cor de destaque a ícones de pastas."

#: chromaleon.js:388
msgid "Application icon theme"
msgstr "Tema de ícones em apps"

#: chromaleon.js:389
msgid "Applies the accent color to some app icons."
msgstr "Aplica a cor de destaque a alguns ícones de apps."

#: chromaleon.js:397
msgid "MoreWaita"
msgstr "MoreWaita"

#: chromaleon.js:398
msgid "Applies integration with the MoreWaita icon pack."
msgstr "Aplica a integração com o pacote de ícones MoreWaita."

#: chromaleon.js:441
msgid "Miscellaneous"
msgstr "Diversos"

#: chromaleon.js:446
msgid "Apply to Flatpaks"
msgstr "Aplicar em Flatpaks"

#: chromaleon.js:448
msgid "Allow Flatpaks to access your custom accent color variables."
msgstr ""
"Permitir que os Flatpaks acedam as suas variáveis de cor de destaque "
"personalizadas."

#: chromaleon.js:456
msgid "Enable shortcut"
msgstr "Ativar atalho"

#: chromaleon.js:458
msgid "Create a shortcut in the app grid by adding a .desktop file."
msgstr "Cria um atalho na grade de apps a adicionar um ficheiro .desktop."

#: chromaleon.js:628
msgid "Wallpaper deleted successfully!"
msgstr "Plano de fundo apagado com sucesso!"

#: chromaleon.js:635
msgid "Failed to delete wallpaper"
msgstr "Falha ao apagar plano de fundo"

#: chromaleon.js:642
msgid "Select a Wallpaper"
msgstr "Selecionar um plano de fundo"

#: chromaleon.js:644
msgid "_Open"
msgstr "Abrir"

#: chromaleon.js:645
msgid "_Cancel"
msgstr "Cancelar"

#: chromaleon.js:650
msgid "All Images"
msgstr "Todas as imagens"

#: chromaleon.js:677
msgid "Wallpaper already exists!"
msgstr "Plano de fundo já existe!"

#: chromaleon.js:693
msgid "Wallpaper added successfully!"
msgstr "Plano de fundo adicionado com sucesso!"

#: chromaleon.js:1143
msgid "Unable to load colors."
msgstr "Não foi possível carregar as cores."

#: chromaleon.js:1285 chromaleon.js:1310
msgid "Support"
msgstr "Apoiar"

#: chromaleon.js:1297
msgid "Support the project"
msgstr "Apoie o projeto"

#: chromaleon.js:1303
msgid "Why support ChromaLeon?"
msgstr "Por que apoiar o ChromaLeon?"

#: chromaleon.js:1305
msgid ""
"Developing free software requires time, energy, and dedication. Your "
"donation directly supports the project and helps keep it alive!"
msgstr ""
"Desenvolver software livre requer tempo, energia e dedicação. A sua doação "
"apoia diretamente o projeto e ajuda a mantê-lo vivo!"

#: chromaleon.js:1309
msgid "Cancel"
msgstr "Cancelar"

