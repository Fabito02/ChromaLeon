msgstr "偏好亮色样式"

#: ui/preferencesPage.js:168
msgid "Use a light style for the Shell in the light theme."
msgstr "亮色模式下，为 Shell 采用浅色样式。"

#: ui/preferencesPage.js:174
msgid "Fully Light"
msgstr "全亮色"

#: ui/preferencesPage.js:176
msgid ""
"Use a fully light style instead of the default style for the GNOME Shell "
"light theme."
msgstr "浅色主题下，为 GNOME Shell 采用全亮色样式而非默认样式。"

#: ui/preferencesPage.js:219
msgid "Tint GNOME"
msgstr "GNOME 界面着色"

#: ui/preferencesPage.js:220
