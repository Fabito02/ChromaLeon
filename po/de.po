#: chromaleon.js:111
msgid "Wallpaper"
msgstr "Hintergrundbild"

#: chromaleon.js:115
msgid "Preferences"
msgstr "Einstellungen"

#: chromaleon.js:148
msgid "Accent Color"
msgstr "Akzentfarbe"

#: chromaleon.js:149
msgid "New colors only apply when apps are reopened."
msgstr ""
"Neue Farben werden erst bei erneutem Öffnen von Anwendungen angewendet."

#: chromaleon.js:153
msgid "Main color"
msgstr "Hauptfarbe"

#: chromaleon.js:176
msgid "Wallpaper Colors"
msgstr "Farben des Hintergrundbilds"

#: chromaleon.js:178
msgid ""
"The system automatically updates the accent color based on your wallpaper."
msgstr ""
"Das System aktualisiert die Akzentfarbe automatisch basierend auf dem "
"Hintergrundbild."

#: chromaleon.js:213
msgid "Additional colors"
msgstr "Weitere Farben"

#: chromaleon.js:250
msgid "Add wallpapers"
msgstr "Hintergrundbild hinzufügen"

#: chromaleon.js:264
msgid "Wallpapers"
msgstr "Hintergrundbilder"

#: chromaleon.js:287
msgid "Tint GNOME"
msgstr "GNOME einfärben"

#: chromaleon.js:288
msgid "Based on Tint my GNOME"
msgstr "Basiert auf Tint my GNOME"

#: chromaleon.js:293
msgid "Tint Shell"
msgstr "Einfärbe-Shell"

#: chromaleon.js:294
msgid "Tints the GNOME Shell with the color of your choice."
msgstr "Färbt die GNOME Shell in den von dir gewählten Farben."

#: chromaleon.js:302
msgid "Tint Apps"
msgstr "Anwendungen einfärben"

#: chromaleon.js:304
msgid "Tints the LibAdwaita applications with the color of your choice."
msgstr "Färbt die LibAdwaita-Anwendungen in den von dir gewählten Farben."

#: chromaleon.js:313
msgid ""
"Also tint the GTK3 apps (the {0} extension and the {1} theme are required to "
"avoid bugs)."
msgstr ""
"Auch GTK3-Anwendungen einfärben (die {0}-Erweiterung und das {1}-Design "
"werden benötigt um Fehler zu verhindern)."

#: chromaleon.js:326
msgid "Tint GTK3 Apps"
msgstr "GTK3-Anwendungen einfärben"

#: chromaleon.js:363
msgid "Icon Theme"
msgstr "Symbol-Design"

#: chromaleon.js:368
msgid "Folder icon theme"
msgstr "Ordnersymbol-Design"

#: chromaleon.js:369
msgid "Applies the accent color to folder icons."
msgstr "Wendet die Akzentfarbe auf Ordnersymbole an."

#: chromaleon.js:377
msgid "Application icon theme"
msgstr "Anwendungssymbol-Design"

#: chromaleon.js:378
msgid "Applies the accent color to some app icons."
msgstr "Wendet die Akzentfarbe auf manche Anwendungssymbole an."

#: chromaleon.js:386
msgid "MoreWaita"
msgstr "MoreWaita"

#: chromaleon.js:387
msgid "Applies integration with the MoreWaita icon pack."
msgstr "Wendet Integration mit dem MoreWaita-Symbolpaket an."

#: chromaleon.js:430
msgid "Miscellaneous"
msgstr "Verschiedenes"

#: chromaleon.js:435
msgid "Apply to Flatpaks"
msgstr "Auf Flatpaks anwenden"

#: chromaleon.js:437
msgid "Allow Flatpaks to access your custom accent color variables."
msgstr ""
"Flatpaks erlauben auf benutzerdefinierte Akzentfarbenvariablen zuzugreifen."

#: chromaleon.js:445
msgid "Enable Firefox support"
msgstr ""

#: chromaleon.js:447
msgid ""
"Matches Firefox and some derivatives colors with your system accent color "
"instead of GNOME defaults"
msgstr ""

#: chromaleon.js:472
msgid "Disable Firefox accent theme?"
msgstr ""

#: chromaleon.js:474
msgid ""
"Firefox needs to close to apply this change. Please ensure any unsaved work "
"is saved."
msgstr ""

#: chromaleon.js:478 chromaleon.js:1356
msgid "Cancel"
msgstr "Abbrechen"

#: chromaleon.js:479
msgid "Continue"
msgstr ""

#: chromaleon.js:500
msgid "Enable shortcut"
msgstr "Tastenkürzel aktivieren"

#: chromaleon.js:502
msgid "Create a shortcut in the app grid by adding a .desktop file."
msgstr ""
"Erstelle eine Verknüpfung im Anwendungsraster durch das Hinzufügen "
"einer .desktop Datei."

#: chromaleon.js:675
msgid "Wallpaper deleted successfully!"
msgstr "Hintergrundbild erfolgreich gelöscht!"

#: chromaleon.js:682
msgid "Failed to delete wallpaper"
msgstr "Löschen von Hintergrundbild fehlgeschlagen"

#: chromaleon.js:689
msgid "Select a Wallpaper"
msgstr "Wähle ein Hintergrundbild"

#: chromaleon.js:691
msgid "_Open"
msgstr "_Öffnen"

#: chromaleon.js:692
msgid "_Cancel"
msgstr "_Abbrechen"

#: chromaleon.js:697
msgid "All Images"
msgstr "Alle Bilder"

#: chromaleon.js:724
msgid "Wallpaper already exists!"
msgstr "Hintergrundbild existiert bereits!"

#: chromaleon.js:740
msgid "Wallpaper added successfully!"
msgstr "Hintergrundbild erfolgreich hinzugefügt!"

#: chromaleon.js:1190
msgid "Unable to load colors."
msgstr "Farben konnten nicht geladen werden."

#: chromaleon.js:1332 chromaleon.js:1357
msgid "Support"
msgstr "Unterstützen"

#: chromaleon.js:1344
msgid "Support the project"
msgstr "Unterstütze das Projekt"

#: chromaleon.js:1350
msgid "Why support ChromaLeon?"
msgstr "Warum ChromaLeon unterstützen?"

#: chromaleon.js:1352
msgid ""
"Developing free software requires time, energy, and dedication. Your "
"donation directly supports the project and helps keep it alive!"
msgstr ""
"Freie Software zu entwickeln kostet Zeit, Energie und Hingabe. Deine Spende "
"unterstützt das Projekt direkt und hilft dabei es am Leben zu erhalten!"
