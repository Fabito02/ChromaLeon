#: chromaleon.js:326
msgid "Based on Tint my GNOME"
msgstr "Basiert auf Tint my GNOME"

#: chromaleon.js:331
msgid "Tint Shell"
msgstr "Einfärbe-Shell"

#: chromaleon.js:332
msgid "Tints the GNOME Shell with the color of your choice."
msgstr "Färbt die GNOME Shell in den von dir gewählten Farben."

#: chromaleon.js:340
msgid "Tint Apps"
msgstr "Anwendungen einfärben"

#: chromaleon.js:342
msgid "Tints the LibAdwaita applications with the color of your choice."
msgstr "Färbt die LibAdwaita-Anwendungen in den von dir gewählten Farben."

#: chromaleon.js:351
msgid ""
"Also tint the GTK3 apps (the {0} extension and the {1} theme are required to "
"avoid bugs)."
msgstr ""
"Auch GTK3-Anwendungen einfärben (die {0}-Erweiterung und das {1}-Design "
"werden benötigt um Fehler zu verhindern)."

#: chromaleon.js:364
msgid "Tint GTK3 Apps"
msgstr "GTK3-Anwendungen einfärben"

#: chromaleon.js:373
msgid "Darker Tint"
msgstr ""

#: chromaleon.js:374
msgid "Applies a darker tint."
msgstr ""

#: chromaleon.js:424
msgid "Icon Theme"
msgstr "Symbol-Design"

#: chromaleon.js:429
msgid "Folder icon theme"
msgstr "Ordnersymbol-Design"

#: chromaleon.js:430
msgid "Applies the accent color to folder icons."
msgstr "Wendet die Akzentfarbe auf Ordnersymbole an."

#: chromaleon.js:438
msgid "Application icon theme"
msgstr "Anwendungssymbol-Design"

#: chromaleon.js:439
msgid "Applies the accent color to some app icons."
msgstr "Wendet die Akzentfarbe auf manche Anwendungssymbole an."

#: chromaleon.js:447
msgid "MoreWaita"
msgstr "MoreWaita"

#: chromaleon.js:448
msgid "Applies integration with the MoreWaita icon pack."
msgstr "Wendet Integration mit dem MoreWaita-Symbolpaket an."

#: chromaleon.js:491
msgid "Customization"
msgstr ""

#: chromaleon.js:496
msgid "Custom stylesheet"
msgstr ""

#: chromaleon.js:498
msgid ""
"A file that overrides the CSS of the shell and user extensions, with support "
"for ChromaLeon accent colors."
msgstr ""

#: chromaleon.js:505 chromaleon.js:521
msgid "About the custom stylesheet"
msgstr ""

#: chromaleon.js:511
msgid "Open file"
msgstr ""

#: chromaleon.js:523
msgid ""
"This file is used to apply custom CSS to GNOME Shell.\n"
"\n"
"The extension processes all content within this file, replacing the "
"<b><tt>@@ACCENT@@</tt></b> and <b><tt>-st-accent-color</tt></b> variables "
"with the color selected in the ChromaLeon settings before applying them to "
"the system. This can be useful if an extension does not have the accent "
"colors applied correctly.\n"
"\n"
"<b>Tip:</b> If your changes do not take effect, try adding <b><tt>!"
"important</tt></b> to your CSS rules."
msgstr ""

